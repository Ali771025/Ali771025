FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-dev \
    build-essential cmake ninja-build git pkg-config \
    libopencv-dev \
    libyaml-cpp-dev libspdlog-dev libfmt-dev \
    qt6-base-dev \
    wget curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Python dependencies
COPY python/requirements.txt ./python/requirements.txt
COPY python/pyproject.toml ./python/pyproject.toml
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir -r python/requirements.txt && \
    pip3 install --no-cache-dir onnxruntime PySide6 || true

# Copy project
COPY . .

# Build C++ (CPU, ONNX Runtime if available via apt - optional)
RUN cmake -S cpp -B /tmp/build -DCMAKE_BUILD_TYPE=Release -DYOLO_WITH_QT=OFF -DYOLO_WITH_ONNXRUNTIME=OFF || true && \
    cmake --build /tmp/build -j || true

# Default command
CMD ["python3", "-m", "yolo_monitor", "--help"]


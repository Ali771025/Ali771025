DASH_ENV=development
DASH_HOST=0.0.0.0
DASH_PORT=8080
DASH_DATABASE_PATH=./runtime/dashboard.db
DASH_JWT_SECRET=change-this-to-at-least-32-random-characters
DASH_EXPERT_USERNAME=expert
DASH_EXPERT_PASSWORD=change-expert-password
DASH_MANAGER_USERNAME=manager
DASH_MANAGER_PASSWORD=change-manager-password
DASH_UDP_HOST=0.0.0.0
DASH_UDP_PORT=15010
DASH_TCP_HOST=0.0.0.0
DASH_TCP_PORT=15011
# Shared HMAC secret used to authenticate telemetry/alert ingest.
# Leave empty in development to accept unsigned envelopes; in production
# all trusted bridge clients MUST sign envelopes with the same secret.
DASH_INGEST_SHARED_SECRET=
DASH_WS_QUEUE_SIZE=128
DASH_TELEMETRY_SAMPLE_HZ=2
DASH_CONTROL_MODE=simulation
DASH_CONTROL_REQUIRE_DUAL_APPROVAL=true
DASH_CONTROL_GATEWAY_URL=
DASH_CONTROL_GATEWAY_SECRET=
DASH_OLLAMA_URL=http://127.0.0.1:11434
DASH_OLLAMA_MODEL=qwen2.5:7b-instruct
DASH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

